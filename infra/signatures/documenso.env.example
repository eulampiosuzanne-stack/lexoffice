# LEXOFFICE • Documenso self-hosted
# Copie para .env apenas na VPS. NUNCA comite senhas reais.

POSTGRES_USER=documenso
POSTGRES_PASSWORD=ALTERE_NA_VPS
POSTGRES_DB=documenso

NEXTAUTH_SECRET=ALTERE_NA_VPS
NEXT_PRIVATE_ENCRYPTION_KEY=ALTERE_NA_VPS
NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY=ALTERE_NA_VPS

NEXT_PUBLIC_WEBAPP_URL=https://assinaturas.seu-dominio.com.br
NEXT_PRIVATE_INTERNAL_WEBAPP_URL=http://documenso:3000

NEXT_PRIVATE_DATABASE_URL=postgresql://documenso:ALTERE_NA_VPS@database:5432/documenso
NEXT_PRIVATE_DIRECT_DATABASE_URL=postgresql://documenso:ALTERE_NA_VPS@database:5432/documenso

NEXT_PRIVATE_SIGNING_TRANSPORT=local
NEXT_PRIVATE_SIGNING_LOCAL_FILE_PATH=/opt/documenso/cert.p12
NEXT_PRIVATE_SIGNING_PASSPHRASE=ALTERE_NA_VPS

NEXT_PRIVATE_SMTP_TRANSPORT=smtp-auth
NEXT_PRIVATE_SMTP_HOST=smtp.seu-provedor.com
NEXT_PRIVATE_SMTP_PORT=587
NEXT_PRIVATE_SMTP_USERNAME=ALTERE_NA_VPS
NEXT_PRIVATE_SMTP_PASSWORD=ALTERE_NA_VPS
NEXT_PRIVATE_SMTP_FROM_NAME=LEXOFFICE Assinaturas
NEXT_PRIVATE_SMTP_FROM_ADDRESS=assinaturas@seu-dominio.com.br
NEXT_PRIVATE_SMTP_SECURE=false

NEXT_PUBLIC_UPLOAD_TRANSPORT=database
NEXT_PUBLIC_DISABLE_SIGNUP=true
